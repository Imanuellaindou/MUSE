<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.muse.controller.AlatMusikController"
      spacing="12" VBox.vgrow="ALWAYS">

    <!-- Judul -->
    <Label text="Data Alat Musik" styleClass="page-title"/>

    <!-- Toolbar -->
    <HBox styleClass="toolbar" spacing="8" alignment="CENTER_LEFT">
        <Button fx:id="btnTambah"   text="+ Tambah"   styleClass="btn-primary"   onAction="#onTambah"/>
        <Button fx:id="btnEdit"     text="- Edit"     styleClass="btn-secondary" onAction="#onEdit"/>
        <Button fx:id="btnHapus"    text="■ Hapus"    styleClass="btn-danger"    onAction="#onHapus"/>
        <Button fx:id="btnRefresh"  text="↻ Refresh"  styleClass="btn-secondary" onAction="#onRefresh"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Label text="Cari:" style="-fx-font-size:12px;"/>
        <TextField fx:id="tfCari"
                   promptText="Nama alat..."
                   styleClass="search-field"
                   prefWidth="180"
                   onKeyReleased="#onCari"/>

        <ComboBox fx:id="cbStatus"
                  styleClass="combo-box"
                  prefWidth="140"
                  onAction="#onFilterStatus"/>
    </HBox>

    <!-- Tabel -->
    <TableView fx:id="tableAlat"
               styleClass="table-view"
               VBox.vgrow="ALWAYS"
               columnResizePolicy="">
        <columns>
            <TableColumn fx:id="colId"       text="ID"              prefWidth="60"/>
            <TableColumn fx:id="colNama"     text="Nama Alat"/>
            <TableColumn fx:id="colJenis"    text="Jenis"           prefWidth="100"/>
            <TableColumn fx:id="colHarga"    text="Harga Sewa/hari" prefWidth="140"/>
            <TableColumn fx:id="colStatus"   text="Status"          prefWidth="100"/>
        </columns>
        <placeholder><Label text="Tidak ada data alat musik."/></placeholder>
    </TableView>

    <!-- Info -->
    <Label fx:id="lblInfo" styleClass="status-text"/>

</VBox>
