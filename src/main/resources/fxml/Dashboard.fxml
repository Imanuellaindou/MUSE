<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.DashboardController"
      spacing="16" VBox.vgrow="ALWAYS">

    <!-- Judul -->
    <Label text="Dashboard" styleClass="page-title"/>

    <!-- Notifikasi Keterlambatan -->
    <HBox fx:id="notifBox" styleClass="notif-warning"
          alignment="CENTER_LEFT" spacing="8"
          visible="false" managed="false">
        <Label fx:id="lblNotif" styleClass="notif-warning-text"/>
    </HBox>

    <!-- Kartu Statistik -->
    <HBox spacing="16" alignment="CENTER_LEFT">
        <!-- Total Alat -->
        <VBox styleClass="stat-card" alignment="CENTER" spacing="4">
            <Label fx:id="lblTotalAlat" text="0" styleClass="stat-number stat-number-blue"/>
            <Label text="Total Alat" styleClass="stat-label"/>
        </VBox>

        <!-- Tersedia -->
        <VBox styleClass="stat-card" alignment="CENTER" spacing="4">
            <Label fx:id="lblTersedia" text="0" styleClass="stat-number stat-number-green"/>
            <Label text="Tersedia" styleClass="stat-label"/>
        </VBox>

        <!-- Sedang Disewa -->
        <VBox styleClass="stat-card" alignment="CENTER" spacing="4">
            <Label fx:id="lblDisewa" text="0" styleClass="stat-number stat-number-orange"/>
            <Label text="Sedang Disewa" styleClass="stat-label"/>
        </VBox>

        <!-- Denda Aktif -->
        <VBox styleClass="stat-card" alignment="CENTER" spacing="4">
            <Label fx:id="lblDendaAktif" text="0" styleClass="stat-number stat-number-red"/>
            <Label text="Denda Aktif" styleClass="stat-label"/>
        </VBox>
    </HBox>

    <!-- Tabel Transaksi Aktif -->
    <Label text="Transaksi Aktif Terkini"
           style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #374151;"/>

    <TableView fx:id="tableTransaksiAktif"
               styleClass="table-view"
               VBox.vgrow="ALWAYS"
               columnResizePolicy="">
        <columns>
            <TableColumn fx:id="colId"        text="ID"          prefWidth="80"/>
            <TableColumn fx:id="colPelanggan" text="Pelanggan"/>
            <TableColumn fx:id="colAlat"      text="Alat Musik"/>
            <TableColumn fx:id="colTglKembali" text="Tgl Kembali" prefWidth="110"/>
            <TableColumn fx:id="colStatus"    text="Status"      prefWidth="100"/>
        </columns>
        <placeholder><Label text="Tidak ada transaksi aktif."/></placeholder>
    </TableView>

    <!-- Info + shortcut buttons -->
    <Label fx:id="lblJumlahAktif" styleClass="status-text"/>

    <HBox spacing="12">
        <Button text="+ Transaksi Baru"
                styleClass="btn-primary"
                onAction="#onTransaksiBaru"/>
        <Button text="↩ Proses Pengembalian"
                styleClass="btn-secondary"
                onAction="#onPengembalian"/>
    </HBox>

</VBox>
