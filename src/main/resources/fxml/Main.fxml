<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.muse.controller.MainController"
            styleClass="main-root"
            stylesheets="@../styles/muse.css">

    <!-- ===================== SIDEBAR (LEFT) ===================== -->
    <left>
        <VBox styleClass="sidebar" minWidth="200" maxWidth="200" prefWidth="200">

            <!-- Sidebar Header -->
            <VBox styleClass="sidebar-header" spacing="2">
                <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                <Label text="MUSE" styleClass="sidebar-title"/>
                <Label text="Rental System" styleClass="sidebar-subtitle"/>
            </VBox>

            <!-- Menu Section -->
            <Label text="MENU" styleClass="sidebar-section-label"/>

            <Button fx:id="btnDashboard"
                    text="  ⊞  Dashboard"
                    styleClass="sidebar-btn"
                    maxWidth="Infinity"
                    onAction="#onDashboard"/>

            <Button fx:id="btnAlatMusik"
                    text="  ♪  Alat Musik"
                    styleClass="sidebar-btn"
                    maxWidth="Infinity"
                    onAction="#onAlatMusik"/>

            <Button fx:id="btnPelanggan"
                    text="  ♟  Pelanggan"
                    styleClass="sidebar-btn"
                    maxWidth="Infinity"
                    onAction="#onPelanggan"/>

            <Button fx:id="btnTransaksiBaru"
                    text="  +  Transaksi Baru"
                    styleClass="sidebar-btn"
                    maxWidth="Infinity"
                    onAction="#onTransaksiBaru"/>

            <Button fx:id="btnPengembalian"
                    text="  ↩  Pengembalian"
                    styleClass="sidebar-btn"
                    maxWidth="Infinity"
                    onAction="#onPengembalian"/>

            <!-- Laporan Section -->
            <Label text="LAPORAN" styleClass="sidebar-section-label"/>

            <Button fx:id="btnRiwayat"
                    text="  ⏱  Riwayat"
                    styleClass="sidebar-btn"
                    maxWidth="Infinity"
                    onAction="#onRiwayat"/>

            <Button fx:id="btnLaporan"
                    text="  ▤  Laporan"
                    styleClass="sidebar-btn"
                    maxWidth="Infinity"
                    onAction="#onLaporan"/>

            <!-- Akun Section -->
            <Label text="AKUN" styleClass="sidebar-section-label"/>

            <Button fx:id="btnLogout"
                    text="  ⏻  Logout"
                    styleClass="sidebar-logout"
                    maxWidth="Infinity"
                    onAction="#onLogout"/>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <!-- ===================== CONTENT AREA (CENTER) ===================== -->
    <center>
        <StackPane fx:id="contentPane" styleClass="content-area"/>
    </center>

    <!-- ===================== STATUS BAR (BOTTOM) ===================== -->
    <bottom>
        <HBox styleClass="status-bar" spacing="24" alignment="CENTER_LEFT">
            <Label fx:id="lblStatusAdmin" styleClass="status-text"/>
            <Label fx:id="lblStatusTanggal" styleClass="status-text"/>
            <Label fx:id="lblStatusTrx" styleClass="status-text"/>
        </HBox>
    </bottom>

</BorderPane>
