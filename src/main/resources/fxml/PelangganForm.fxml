<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.muse.controller.PelangganFormController"
      spacing="16" minWidth="400">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <Label fx:id="lblFormTitle"
           text="Form Pelanggan"
           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1E3A5F;"/>

    <GridPane hgap="16" vgap="12">

        <Label text="Nama Lengkap *" styleClass="form-label"
               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="tfNama"
                   promptText="Nama lengkap pelanggan"
                   styleClass="form-field" prefWidth="260"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="No. Kontak *" styleClass="form-label"
               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="tfKontak"
                   promptText="Nomor HP aktif"
                   styleClass="form-field"
                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Alamat *" styleClass="form-label"
               GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextArea fx:id="taAlamat"
                  promptText="Alamat lengkap pelanggan"
                  prefRowCount="3" prefWidth="260"
                  GridPane.columnIndex="1" GridPane.rowIndex="2"/>

    </GridPane>

    <Label fx:id="lblError" styleClass="login-error" visible="false" managed="false"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="✕ Batal"  styleClass="btn-secondary" onAction="#onBatal"/>
        <Button fx:id="btnSimpan" text="✔ Simpan" styleClass="btn-primary"
                defaultButton="true" onAction="#onSimpan"/>
    </HBox>

</VBox>
